{
  "name": "swipe-onnx-test",
  "version": "1.0.0",
  "description": "ONNX model testing for swipe typing",
  "scripts": {
    "test": "ts-node test-onnx-pipeline.ts",
    "test:quick": "ts-node test-onnx-pipeline.ts . ../data/train_final_val.jsonl 10",
    "test:full": "ts-node test-onnx-pipeline.ts . ../data/train_final_val.jsonl 1000",
    "build": "tsc",
    "serve": "python3 -m http.server 3001"
  },
  "dependencies": {
    "onnxruntime-node": "^1.22.0-rev",
    "onnxruntime-web": "^1.16.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^20.10.0",
    "playwright": "^1.55.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}
